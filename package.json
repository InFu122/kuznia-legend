{
  "name": "kuznia-legend",
  "private": true,
  "version": "0.1.0",
  "description": "Kuźnia Legend — mobilne idle RPG o wytapianiu rud i legendach przedmiotów",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "build:artifact": "npm run build:single && vite-node tools/artifact-pack.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "balance": "vite-node tools/balance-sim.ts"
  },
  "dependencies": {
    "preact": "10.24.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.9.1",
    "exceljs": "4.4.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.5"
  }
}
