# Gra w przeglądarce (nginx). API Nakamy jest pod tym samym adresem (/v2), więc telefon w sieci domowej
# otwiera tylko http://adres-serwera:8080.

# 1) Build gry
FROM node:20-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG VITE_SERVER_KEY=defaultkey
# Strony dla Google Play (polityka prywatności, usuwanie konta) i app-ads.txt — dane z .env (docker-compose.yml)
ARG OWNER_NAME=
ARG CONTACT_EMAIL=
ARG ADMOB_PUBLISHER_ID=
ENV VITE_SERVER_URL=/ VITE_SERVER_KEY=${VITE_SERVER_KEY} OWNER_NAME=${OWNER_NAME} CONTACT_EMAIL=${CONTACT_EMAIL} ADMOB_PUBLISHER_ID=${ADMOB_PUBLISHER_ID}
RUN npm run build

# 2) Serwer WWW
FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
