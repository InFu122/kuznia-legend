# Skopiuj do pliku .env i zmień WSZYSTKIE wartości. Używaj samych liter i cyfr (bez znaków specjalnych).
# Losowy klucz wygenerujesz np.: openssl rand -hex 16

POSTGRES_PASSWORD=zmien-haslo-bazy

# Klucz serwera trafia do gry (to normalne w Nakamie) — chroni przed przypadkowymi klientami, nie jest tajny.
NAKAMA_SERVER_KEY=zmien-klucz-serwera
# Klucze tajne: sesje graczy, wywołania serwer-serwer, konsola. Każdy MUSI być inny (Nakama nie wystartuje,
# gdy klucz sesji i klucz odświeżania są takie same). Nie musisz ich pamiętać — wygenerujesz je tak:
#   for k in NAKAMA_SESSION_KEY NAKAMA_REFRESH_KEY NAKAMA_HTTP_KEY NAKAMA_CONSOLE_KEY; do sed -i "s/^$k=.*/$k=$(openssl rand -hex 16)/" .env; done
NAKAMA_SESSION_KEY=zmien-klucz-sesji
NAKAMA_REFRESH_KEY=zmien-klucz-odswiezania
NAKAMA_HTTP_KEY=zmien-klucz-http
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=zmien-haslo-konsoli
NAKAMA_CONSOLE_KEY=zmien-klucz-konsoli

# Porty na serwerze domowym
WEB_PORT=8080
NAKAMA_PORT=7350
NAKAMA_CONSOLE_PORT=7351
